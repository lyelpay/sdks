{
  "name": "@lyel/lyel-pay-node",
  "version": "0.2.0",
  "description": "Lyel Pay Node.js SDK: server-side payment intents and webhook verification",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "jest --config jest.config.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=18"
  }
}
