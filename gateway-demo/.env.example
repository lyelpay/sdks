# Copy to .env.local (never committed) and fill in the merchant TEST keys from the developer portal.
LYEL_API_URL=https://<dev api host>
LYEL_TEST_SECRET_KEY=sk_test_...
LYEL_TEST_PUBLISHABLE_KEY=pk_test_...
# Checkout widget: the dev one by default. Set http://localhost:5174 to run ../checkout-ui locally instead.
LYEL_CHECKOUT_URL=https://dev.checkout.lyelpay.com
# Shop port (4310 by default; 4300 is kept for the QA shop).
PORT=4310
